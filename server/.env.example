# KVS Asset Management API

# Environment
NODE_ENV=development

# ---- Database ----
# Local PostgreSQL (used when NODE_ENV=development)
DATABASE_URL_LOCAL=postgresql://postgres:password@localhost:5432/kvs_assets_dev

# Production Neon PostgreSQL (used when NODE_ENV=production)
DATABASE_URL_PROD=postgresql://user:password@host/dbname?sslmode=require

# JWT
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=7d
